# ---------------------------------------------------------------------------
# Contact form — email delivery
#
# Copy this file to `.env.local` and fill it in:
#
#     cp .env.local.example .env.local
#
# `.env.local` is git-ignored and is read automatically by `next dev` and
# `next build`. Nothing here is exposed to the browser: only variables prefixed
# with NEXT_PUBLIC_ are, and none of these are. On a host like Vercel, add the
# same keys under Project Settings → Environment Variables.
#
# Without RESEND_API_KEY the form still validates every submission, but
# POST /api/contact answers 503 and no email is sent.
# ---------------------------------------------------------------------------

# Your Resend API key. Create one (free tier is plenty for a portfolio) at:
#   https://resend.com/api-keys
# Keys look like `re_xxxxxxxx...`. Treat it like a password — never commit it.
RESEND_API_KEY=

# Where enquiries are delivered.
# Optional: defaults to SITE.email from src/lib/site.ts.
MAIL_TO=

# The From address on outgoing mail.
# Optional: defaults to `Portfolio Contact Form <onboarding@resend.dev>`.
#
# IMPORTANT — the onboarding@resend.dev limitation:
#   `onboarding@resend.dev` is Resend's shared testing sender. It works the
#   moment you have a key, with no DNS setup, BUT it can only deliver to the
#   email address that owns the Resend account. Send to anything else and the
#   API returns a 403 and the message never arrives.
#
#   So: fine for testing against your own inbox, not fine in production — the
#   auto-reply to the visitor will silently fail.
#
# To send to anyone (and to make the auto-reply work), verify a domain at
# https://resend.com/domains — add the DNS records it gives you — then set:
#   MAIL_FROM="Portfolio Contact Form <hello@yourdomain.com>"
MAIL_FROM=
